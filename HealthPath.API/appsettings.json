{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=YOUR_POSTGRES_HOST;Database=YOUR_DATABASE_NAME;Username=YOUR_USERNAME;Password=YOUR_PASSWORD"
  },
  "Jwt": {
    "Key": "YOUR_32_CHAR_JWT_KEY_HERE"
  },
  "CloudflareR2": {
    "AccountId": "YOUR_CLOUDFLARE_R2_ACCOUNT_ID",
    "AccessKeyId": "YOUR_CLOUDFLARE_R2_ACCESS_KEY_ID",
    "SecretAccessKey": "YOUR_CLOUDFLARE_R2_SECRET_ACCESS_KEY",
    "BucketName": "YOUR_BUCKET_NAME",
    "PublicDomain": "https://YOUR_PUBLIC_R2_DOMAIN.dev"
  },
  "Firebase": {
    "CredentialPath": "firebase-service-account.json"
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "YOUR_EMAIL@domain.com",
    "Password": "YOUR_APP_SPECIFIC_PASSWORD",
    "FromName": "HealthPath",
    "FromEmail": "YOUR_EMAIL@domain.com"
  }
}