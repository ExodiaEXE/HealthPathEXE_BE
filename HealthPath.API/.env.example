# Copy this file to .env and fill in your values.
# cp .env.example .env

# Supabase pooler — dev & small deploy: cả EF + Hangfire dùng session :5432
# Production scale: DefaultConnection Port 6543 (transaction), HangfireConnection Port 5432 (session)
ConnectionStrings__DefaultConnection="Host=YOUR_HOST;Port=5432;Database=postgres;Username=postgres.PROJECT_REF;Password=YOUR_PASSWORD;SSL Mode=Require;Trust Server Certificate=true"
ConnectionStrings__HangfireConnection="Host=YOUR_HOST;Port=5432;Database=postgres;Username=postgres.PROJECT_REF;Password=YOUR_PASSWORD;SSL Mode=Require;Trust Server Certificate=true"
Hangfire__Enabled=true

Jwt__Key="YOUR_32_CHAR_JWT_KEY_HERE"
Jwt__Issuer="HealthPathAPI"
Jwt__Audience="HealthPathApp"
Jwt__ExpireDays=7

CloudflareR2__AccountId=""
CloudflareR2__AccessKeyId=""
CloudflareR2__SecretAccessKey=""
CloudflareR2__BucketName=""
CloudflareR2__PublicDomain=""

Firebase__CredentialPath="firebase-service-account.json"

Smtp__Host="smtp.gmail.com"
Smtp__Port=587
Smtp__Username=""
Smtp__Password=""
Smtp__FromName="HealthPath"
Smtp__FromEmail=""

IAP__MockMode=true
IAP__Google__ServiceAccountKey=""
IAP__Apple__SharedSecret=""

# ===================================================================
# SOCIAL LOGIN (Google / Facebook) — xác minh token từ mobile
# ===================================================================
# Backend KHÔNG cần OAuth redirect. Mobile gửi id_token (Google) hoặc access_token (Facebook).
#
# GOOGLE: danh sách Client ID (Web + Android), phân tách dấu phẩy — khớp claim "aud" trong id_token
#   Ví dụ: 123456-web.apps.googleusercontent.com,123456-android.apps.googleusercontent.com
SocialAuth__AllowMockTokens=true
SocialAuth__GoogleClientIds=""
#
# FACEBOOK: App ID + App Secret (Settings → Basic) — dùng debug_token (khuyến nghị production)
SocialAuth__FacebookAppId=""
SocialAuth__FacebookAppSecret=""
# Production: đặt SocialAuth__AllowMockTokens=false

DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin@123
DEFAULT_ADMIN_EMAIL=admin@healthpath.vn
