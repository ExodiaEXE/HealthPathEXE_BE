meta {
  name: Admin Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/admin/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "admin",
    "password": "admin@123"
  }
}

script:post-response {
  if (res.status === 200 && res.body.success) {
    bru.setVar("token", res.body.data.token);
  }
}
