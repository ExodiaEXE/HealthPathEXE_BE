meta {
  name: Social Login
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/Auth/social-login
  body: json
  auth: none
}

body:json {
  {
    "token": "mock_google_token_testuser123",
    "provider": "google"
  }
}

script:post-response {
  if (res.status === 200 && res.body.success) {
    bru.setVar("token", res.body.data.token);
  }
}
