meta {
  name: Login User
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/Auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "student@fpt.edu.vn",
    "password": "Password123!"
  }
}

script:post-response {
  if (res.status === 200 && res.body.success) {
    bru.setVar("token", res.body.data.token);
  }
}
